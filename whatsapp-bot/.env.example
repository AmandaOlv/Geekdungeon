# URL base da Evolution API (onde o servidor está rodando)
EVOLUTION_API_URL=http://localhost:8080

# Chave de API da Evolution API (definida no .env do servidor Evolution)
EVOLUTION_API_KEY=sua-chave-aqui

# Nome da instância WhatsApp (identificador único)
INSTANCE_NAME=geekdungeon-bot

# URL que a Evolution API vai chamar para enviar mensagens recebidas
# Se Evolution API rodar local, pode usar http://localhost:PORT/webhook
# Se Evolution API rodar em servidor remoto, precisa ser uma URL pública (use ngrok)
WEBHOOK_URL=http://localhost:3000/webhook

# Porta do servidor webhook local
WEBHOOK_PORT=3000

# URL da API Python (FastAPI) deste projeto
PYTHON_API_URL=http://localhost:8000

# Números autorizados (separados por vírgula). Fora dessa lista o bot NÃO responde.
# Use DDI + DDD + número. Grupos nunca são atendidos.
ALLOWED_NUMBERS=+55 88 0000-0000,+55 88 0000-0001
